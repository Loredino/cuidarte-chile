# ---------------------------------------------------------------
# CuidARTE Chile - variables de entorno (plantilla)
# Copia este archivo como ".env" y completa los valores.
# NUNCA subas el archivo ".env" a GitHub.
# ---------------------------------------------------------------

# Puerto del servidor (en Render lo define la plataforma)
PORT=3000

# --- Base de datos LOCAL (desarrollo en tu PC) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=cuidarte_db

# --- Base de datos EN LA NUBE (producción, ej: Neon) ---
# Si DATABASE_URL está definida, se usa en lugar de las variables DB_*.
# Ejemplo: postgresql://usuario:clave@host.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Secreto para firmar los tokens JWT (texto largo y aleatorio, distinto en cada entorno)
JWT_SECRET=